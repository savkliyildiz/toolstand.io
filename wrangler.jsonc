{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toolstand",
  "main": "worker.js",
  "compatibility_date": "2026-06-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "ANALYTICS_KV",
      "id": "9c001796a0384dc98a9896832d1cb9da"
    }
  ],
  "vars": {
    "ANALYTICS_SECRET": "ts-analytics-2026"
  }
}
